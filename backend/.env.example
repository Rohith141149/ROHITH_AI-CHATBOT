# Required: Groq API key for LLM inference
GROQ_API_KEY=your_groq_api_key_here

# Optional: Comma-separated list of allowed CORS origins
# Defaults to http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# Optional: API key to protect the /train endpoint
# If not set, the endpoint is unprotected
TRAIN_API_KEY=your_train_api_key_here

# Optional: Set to "development" to enable /docs and /redoc endpoints
# Defaults to "production" (docs disabled)
ENV=production
